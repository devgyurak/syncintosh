{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run ty:*)",
      "Bash(uv run python scripts/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(rg:*)",
      "Bash(wc:*)"
    ],
    "ask": [
      "Bash(uv add:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv run python -c:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|Bash|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/agent_hooks/guard_secrets.py\" --tool claude",
            "timeout": 15,
            "statusMessage": "Checking for secret / plaintext access..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/agent_hooks/format_python.py\" --tool claude",
            "timeout": 90,
            "statusMessage": "Applying ruff..."
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/agent_hooks/check_layering.py\" --tool claude",
            "timeout": 30,
            "statusMessage": "Checking layer dependencies..."
          }
        ]
      }
    ]
  }
}
