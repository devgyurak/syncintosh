# Invented values on real Ghostty key names (Ghostty 1.3.1).
# Fonts: the family list is ordered, the first one that has a glyph wins.
font-family = Fixture Mono
font-family = Fixture Symbols
font-family = Fixture Emoji
font-family-bold = Fixture Mono Heavy
font-family-italic = Fixture Mono Slanted
font-size = 13
font-thicken = true

theme = fixture-dark
background-opacity = 0.9
background-blur = 20
cursor-style = bar
cursor-style-blink = false

copy-on-select = clipboard
click-repeat-interval = 400
mouse-hide-while-typing = true
scrollback-limit = 10000000

shell-integration = zsh
shell-integration-features = cursor,sudo,title
macos-option-as-alt = true
macos-titlebar-style = tabs
macos-window-shadow = false
unfocused-split-opacity = 0.7
window-colorspace = display-p3
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
window-save-state = always

# Bindings repeat the `keybind` key; their order is meaningful.
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+1=goto_tab:1
keybind = cmd+2=goto_tab:2
keybind = cmd+3=goto_tab:3
keybind = cmd+k=clear_screen
keybind = cmd+shift+comma=reload_config
